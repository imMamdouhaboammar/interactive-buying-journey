{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IBJPluginManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "version",
    "display_name",
    "description",
    "author",
    "runtime",
    "capabilities",
    "permissions",
    "timeout_ms",
    "integrity"
  ],
  "properties": {
    "api_version": {
      "const": "ibj.plugins/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 2
    },
    "runtime": {
      "enum": [
        "declarative",
        "remote-service"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "signal.propose",
          "retrieval.enrich",
          "candidates.score",
          "eligibility.propose",
          "experience.propose",
          "measurement.observe"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_scopes",
        "outbound_hosts",
        "side_effects"
      ],
      "properties": {
        "data_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "catalog_public",
              "buyer_declared_preference",
              "consented_session_summary",
              "merchant_policy",
              "aggregated_metrics"
            ]
          }
        },
        "outbound_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "hostname"
          },
          "maxItems": 5
        },
        "side_effects": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": [
              "emit_bounded_metric"
            ]
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 25,
      "maximum": 250
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "merchant_config_schema": {
      "type": "string",
      "maxLength": 256
    },
    "min_core_version": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 256
    }
  }
}
