{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MerchantEnrichmentReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tenant_id",
    "proposal_id",
    "source_version",
    "catalog_version",
    "decision"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog projection version the merchant saw while reviewing. The server rejects the review with 409 when it differs from the proposal's current catalog_version or the proposal was invalidated."
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}
